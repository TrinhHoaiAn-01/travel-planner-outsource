<?xml version="1.0" encoding="UTF-8" ?>
<schema name="home_destination_search" version="1.6">
  <uniqueKey>id</uniqueKey>
  <fieldType name="string" class="solr.StrField" sortMissingLast="true"/>
  <fieldType name="long" class="solr.LongPointField" docValues="true"/>
  <fieldType name="pint" class="solr.IntPointField" docValues="true"/>
  <fieldType name="pdouble" class="solr.DoublePointField" docValues="true"/>
  <fieldType name="pfloat" class="solr.FloatPointField" docValues="true"/>
  <fieldType name="boolean" class="solr.BoolField"/>
  <fieldType name="text_vi" class="solr.TextField" positionIncrementGap="100">
    <analyzer type="index">
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.ASCIIFoldingFilterFactory"/>
      <filter class="solr.NGramFilterFactory" minGramSize="1" maxGramSize="25" preserveOriginal="true"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.ASCIIFoldingFilterFactory"/>
    </analyzer>
  </fieldType>

  <field name="id" type="string" indexed="true" stored="true" required="true"/>
  <field name="_version_" type="long" indexed="false" stored="false"/>
  <field name="name" type="text_vi" indexed="true" stored="true"/>
  <field name="slug" type="string" indexed="true" stored="true"/>
  <field name="city_name" type="text_vi" indexed="true" stored="true"/>
  <field name="city_id" type="pint" indexed="true" stored="true"/>
  <field name="category_name" type="text_vi" indexed="true" stored="true"/>
  <field name="category_id" type="pint" indexed="true" stored="true"/>
  <field name="entrance_fee" type="pdouble" indexed="true" stored="true"/>
  <field name="price" type="pdouble" indexed="true" stored="true"/>
  <field name="has_hotel" type="boolean" indexed="true" stored="true"/>
  <field name="rating" type="pfloat" indexed="true" stored="true"/>
  <field name="address" type="text_vi" indexed="true" stored="true"/>
  <field name="description" type="text_vi" indexed="true" stored="true"/>
  <field name="image_url" type="string" indexed="false" stored="true"/>
</schema>
