# The workflow writes the exact image digest to image.env.
APP_PORT=8080
APP_URL=http://localhost:8080
APP_KEY=
DB_DATABASE=travel_planner
DB_USERNAME=travel_planner
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Set SMTP values for password-reset emails. "log" writes mail to app logs.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=hello@example.com
